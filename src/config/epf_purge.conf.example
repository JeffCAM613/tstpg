# ============================================================================
# EPF Data Purge - Configuration file
# ============================================================================
# Copy to src\config\epf_purge.conf (git-ignored) or pass another file with
# --config FILE. One KEY=VALUE per line; lines starting with # are comments.
# Command line options override these values. In the wizard, a value here is
# the default of its question; with --non-interactive it is the answer.
# ============================================================================

# Connection: TNS alias or EZConnect string (PDB service in multitenant).
TNS=localhost:1521/EPFPDB

# Purge parameters. While a plan is open, a purge or preflight without
# --retention, --cutoff, --mode or --depth on the command line follows the
# plan instead.
RETENTION_DAYS=30
# Or a cutoff date instead of the retention: rows dated before this day.
# Used only when no --retention is given.
#CUTOFF=2025-10-01
# FULL | CLOB | LOGS | CLOB_N_LOGS
MODE=FULL
# ALL, or modules separated by commas: PAYMENTS,LOGS,BANK_STATEMENTS
DEPTH=ALL
# Root rows per transaction, 100-100000. Leave unset to use the preflight's
# recommendation in the wizard, or the batch_size_default setting otherwise.
#BATCH_SIZE=1000

# Y or N.
DRY_RUN=N
# Shrink the purged tables afterwards (purge only, not with a dry run).
COMPACT=N
# Enlarge the online redo logs to 4 x 1 GB before the purge (SYS, permanent).
REDO_LOGS=N
# Lower undo_retention and limit the growth of the undo tablespace (4 GB by
# default, setting undo_cap_mb) for the purge; both restored at the end (SYS).
# With a preflight or a dry run it is checked as planned; nothing is applied.
UNDO_TUNING=N

# Requirements (checked by the preflight before every purge).
# When no RMAN database backup newer than 24 hours is found: CONFIRMED (a
# backup was made another way) or NONE (purge without a backup).
#BACKUP=CONFIRMED
# Requirements the DBA confirms are handled although the preflight finds them
# not met: ARCHIVE, UNDO, TEMP separated by commas.
#CONFIRM=ARCHIVE

# Plan of smaller runs: the most redo one run may write, such as 500M or 20G
# (preflight, and the wizard's purge). The preflight then plans the purge in
# runs of at most that much, older data first.
#MAX_REDO=20G

# Output.
#LOG_DIR=D:\epf\logs
NO_COLOR=N

# Passwords are read from the environment (EPF_PASSWORD, EPF_SYS_PASSWORD) or
# a masked prompt. They may be set here, which is discouraged: the file is
# then as sensitive as the passwords.
#EPF_PASSWORD=
#SYS_PASSWORD=
